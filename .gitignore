# Python
__pycache__/
*.pyc
.venv/
venv/

# Never commit real wallet data or keys - scoped precisely to this repo's
# own runtime datadirs (NOT a blanket *.dat/datadir pattern, which would
# also match legitimate source files like bitcoin-source's own
# src/node/data/ip_asn.dat)
/wallet/datadir/
/node-data/
/wallet.dat

# Built release packages - uploaded to GitHub Releases directly, not
# tracked in git history (would bloat the repo with binary archives)
/release_check/

# Vendored decred/atomicswap checkout, kept locally for reference/building
# shcatomicswap against. Its own upstream history already lives at
# github.com/decred/atomicswap; the actual Sharecoin-specific patch is
# tracked in /atomicswap/shcatomicswap/ instead of vendoring the whole tree.
/atomicswap/src/

# Staging area for the separate TVHeroes/coins fork PR (Komodo electrum
# server listing), not part of this repo.
/komodo/

# OS
.DS_Store
Thumbs.db
